{
  "name": "aplica-o-web--main",
  "version": "1.0.0",
  "description": "Aplicação web desenvolvida pelos alunos do 2º semestre do Instituto Mauá de Tecnologia como parte do Projeto Integrador.",
  "scripts": {
    "start": "node backend/src/server.js",
    "test": "jest",
    "test:cobertura": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BellaGHS/Aplica-o-Web-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BellaGHS/Aplica-o-Web-/issues"
  },
  "homepage": "https://github.com/BellaGHS/Aplica-o-Web-#readme",
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "frontend/src/js/site/validacoes.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "backend/src/server.js",
      "backend/src/shared/database/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 68,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
